{
  "name": "workflow-script-harness",
  "version": "1.0.0",
  "description": "Test harness for Claude Code's Dynamic Workflows / Workflow tool DSL — run agent()/parallel()/pipeline() scripts unmodified under node:test, with scripted agent responses instead of real API calls.",
  "main": "src/harness.js",
  "files": [
    "src/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "./scripts/verify.sh all",
    "test:unit": "node --test",
    "test:bdd": "cucumber-js",
    "test:coverage": "./scripts/verify.sh coverage",
    "prepare": "(git rev-parse --is-inside-work-tree >/dev/null 2>&1 && git config core.hooksPath .githooks) || true"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.2.1"
  },
  "keywords": ["workflow", "dynamic-workflows", "testing", "dsl", "sandbox", "claude-code", "anthropic", "ai-agents", "llm-testing", "test-harness", "mock", "vm"],
  "author": "Frederik Vannieuwenhuyse",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vannifr/workflow-script-harness.git"
  },
  "bugs": {
    "url": "https://github.com/vannifr/workflow-script-harness/issues"
  },
  "homepage": "https://github.com/vannifr/workflow-script-harness#readme"
}